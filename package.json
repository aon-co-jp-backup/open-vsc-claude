{
  "name": "open-vsc-claude",
  "displayName": "Open VSC Claude",
  "description": "Pick a language/framework stack (GraphQL+Cosmo/RPoem or TypeScript+Node+REST, or describe your own), view the generated code, and refine it with Claude.",
  "version": "0.1.1",
  "publisher": "aon-co-jp",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Snippets",
    "Other",
    "Machine Learning"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "openVscClaude.open",
        "title": "Open VSC Claude: Open Stack Picker"
      },
      {
        "command": "openVscClaude.setApiKey",
        "title": "Open VSC Claude: Set Anthropic API Key"
      },
      {
        "command": "openVscClaude.loadApiKeyFromFile",
        "title": "Open VSC Claude: Load Anthropic API Key from a .txt file"
      },
      {
        "command": "openVscClaude.checkForUpdates",
        "title": "Open VSC Claude: Check for Updates"
      }
    ],
    "configuration": {
      "title": "Open VSC Claude",
      "properties": {
        "openVscClaude.model": {
          "type": "string",
          "default": "claude-sonnet-5-5",
          "description": "Claude model ID used by \"Generate with Claude\"."
        },
        "openVscClaude.maxTokens": {
          "type": "number",
          "default": 8000,
          "description": "max_tokens for Claude generation."
        },
        "openVscClaude.autoUpdate": {
          "type": "string",
          "enum": [
            "notify",
            "install",
            "off"
          ],
          "default": "notify",
          "enumDescriptions": [
            "Check GitHub Releases once a day and ask before installing (desktop) / show the release page (web).",
            "Check once a day and install a newer release automatically after verifying its SHA-256 (desktop only).",
            "Never check automatically."
          ],
          "description": "Update check for sideloaded .vsix installs. Marketplace / Open VSX installs are updated by VS Code itself."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "node out/test/catalog.test.js",
    "package": "npx @vscode/vsce package",
    "test:vscode": "node out/itest/run.js",
    "vscode:prepublish": "npm run compile && node scripts/build-web.js",
    "build:demo": "npm run compile && node scripts/build-demo.js",
    "build:web": "npm run compile && node scripts/build-web.js",
    "test:web": "node scripts/build-web.js && npx @vscode/test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=out/web/suite.js",
    "docs": "npm run compile && node scripts/gen-docs.js",
    "test:demo": "npm run build:demo && node scripts/e2e-demo.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aon-co-jp/open-vsc-claude.git"
  },
  "bugs": {
    "url": "https://github.com/aon-co-jp/open-vsc-claude/issues"
  },
  "homepage": "https://github.com/aon-co-jp/open-vsc-claude#readme",
  "keywords": [
    "claude",
    "scaffold",
    "graphql",
    "cosmo",
    "fastapi",
    "rust",
    "poem",
    "leptos",
    "rpoem",
    "generator"
  ],
  "browser": "./out/web/extension.js",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
